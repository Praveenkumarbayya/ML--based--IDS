# Copy to .env and edit. Never commit .env.

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_GENERATE_A_32_CHAR_SECRET
API_RELOAD=false

# ---- CORS / frontend ----
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- Rate limiting (per client IP) ----
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_BATCH=300/minute

# ---- Database ----
# SQLite for single-node. For Postgres use:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ids
DATABASE_URL=sqlite+aiosqlite:///./data/ids.db

# ---- Audit ----
JSONL_AUDIT_ENABLED=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Model selection (null = auto-pick best by CV score) ----
DEFAULT_MODEL=
